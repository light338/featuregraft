{
  "name": "featuregraft",
  "version": "0.1.0",
  "private": true,
  "description": "Extract a feature from a Git project, adapt it with an agent, and carry upstream fixes into the adapted copy",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "bin": {
    "featuregraft": "bin/featuregraft.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/git.mjs && node --check src/source.mjs && node --check src/core.mjs && node --check src/mcp.mjs && node --check bin/featuregraft.mjs",
    "demo:setup": "node examples/setup.mjs",
    "demo:live": "node examples/live.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.2",
    "playwright": "1.55.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.4"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
